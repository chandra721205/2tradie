    },
    {
      "name": "Seasonal Alerts",
      "item": [
        {
          "name": "Get All Alerts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/seasonal-alerts",
              "host": ["{{baseUrl}}"],
              "path": ["seasonal-alerts"]
            }
          }
        },
        {
          "name": "Get Alerts (Filtered)",
          "request": {
            "method": "GET",
            "url": {
