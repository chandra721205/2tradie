    },
    {
      "name": "Service Requests",
      "item": [
        {
          "name": "Create Service Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider_id\": 1,\n  \"service_type\": \"equipment\",\n  \"subcategory\": \"JCB\",\n  \"request_description\": \"Need JCB for land leveling of 5 acres. Soil is clay type.\",\n  \"location\": \"My Farm, Pedanandipadu, Guntur\",\n  \"district\": \"Guntur\",\n  \"state\": \"Andhra Pradesh\",\n  \"start_date\": \"2025-10-28\",\n  \"end_date\": \"2025-10-30\",\n  \"budget\": 30000,\n  \"urgency\": \"high\"\n}"
