              "raw": "{\n  \"provider_id\": 2,\n  \"product_category\": \"Seeds\",\n  \"product_name\": \"Chili Hybrid Seeds - G4\",\n  \"price_per_unit\": 500,\n  \"unit_type\": \"100g packet\",\n  \"available_quantity\": 1000,\n  \"stock_status\": \"in_stock\",\n  \"certifications\": [\"Government Certified\", \"High Yield\"]\n}"
